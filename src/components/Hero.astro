---
import { Image } from 'astro:assets';
import heroBg from '../assets/images/bg_chris-prieto-2025.png';
import ScrollArrow from '../components/ui/ScrollArrow.astro';
---
<section class="section section-bg" id="hero">
	<div class="bg">
		<Image src={heroBg} alt="" layout='full-width' width={800} height={600} loading="eager" fetchpriority={'high'} />
	</div>
	<div class="inner hero-intro">
		<h2 class="h1">
			<span class="hero-line"><span>Hi, I am a</span></span>
			<span class="hero-line"><span>Front-End</span></span>
			<span class="hero-line"><span>Web Dev</span></span>
		</h2>
		<div class="hero-text"><p>I work with WordPress, Shopify and Webflow<br /> using CSS, HTML, JavaScript, GSAP, and PHP.</p></div>
	</div>
    <ScrollArrow direction="down" />
</section>