---
import { Image } from 'astro:assets';
import heroBg from '../assets/images/bg_chris-prieto-2025.png';
import ScrollArrow from '../components/ui/ScrollArrow.astro';
---
<section class="section section-bg" id="hero">
	<div class="bg">
		<Image src={heroBg} alt="" layout='full-width' width={1200} height={633} loading="eager" fetchpriority={'high'} />
	</div>
	<div class="inner">
		<h2 class="h1">Hi, I am a<br /> Front-End<br /> Web Dev</h2>
		<div class="hero-text"><p>I work with WordPress, Shopify and Webflow<br /> using CSS, HTML, JavaScript, GSAP, and PHP.</p></div>
	</div>
    <ScrollArrow direction="down" />
</section>